# TLS-терминация перед Gunicorn (SPEECHLAB_ENV=production, API key обязателен).
# Скопируйте в sites-available и подставьте домен / пути к сертификатам.
# Продакшен: app.vandum.ru

upstream speechlab_api {
    server 127.0.0.1:8080;
    keepalive 8;
}

server {
    listen 443 ssl http2;
    server_name app.vandum.ru;

    ssl_certificate     /etc/letsencrypt/live/app.vandum.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.vandum.ru/privkey.pem;

    client_max_body_size 500M;

    location / {
        proxy_pass http://speechlab_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-API-Key $http_x_api_key;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 300s;
        proxy_connect_timeout 10s;
    }
}

server {
    listen 80;
    server_name app.vandum.ru;
    return 301 https://$host$request_uri;
}

