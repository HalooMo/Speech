[Unit]
Description=SpeechLab dubbing API
After=network.target

[Service]
Type=simple
User=speechlab
Group=speechlab
WorkingDirectory=/opt/speechlab
EnvironmentFile=/opt/speechlab/config/.env
ExecStart=/opt/speechlab/.venv/bin/gunicorn -c deploy/gunicorn.conf.py wsgi:app
Restart=on-failure
RestartSec=10
# GPU / большие модели — достаточно памяти
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
