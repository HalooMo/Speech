# Скопируйте в config/.env и заполните значениями.

# Hugging Face: https://huggingface.co/settings/tokens

# Принять условия: pyannote/speaker-diarization-community-1



HF_TOKEN=hf_your_token_here



# LLM (OpenAI-compatible): разметка диалога, перевод — tools/llm.py

OPENAI_API_KEY=sk_your_key_here

OPENAI_BASE_URL=https://api.agentplatform.ru/v1

OPENAI_MODEL=openai/gpt-5.5



# Производительность (рекомендации для GPU)

SPEECHLAB_WHISPER_MODEL=large-v3

SPEECHLAB_COMPUTE_TYPE=float16

SPEECHLAB_TRANSLATE_BATCH_SIZE=12
SPEECHLAB_RESUME=1
SPEECHLAB_SKIP_EMOTION=1
SPEECHLAB_CAST_PER_SPEAKER=1
# SPEECHLAB_SKIP_DEMUCS=1

# HTTP(S) API (python -m server / gunicorn wsgi:app)
SPEECHLAB_ENV=development
# production: обязателен API key; TLS обычно через nginx (deploy/nginx.conf.example)
# SPEECHLAB_ENV=production
SPEECHLAB_REQUIRE_API_KEY=0
SPEECHLAB_API_KEY=your_secret_api_key_here
SPEECHLAB_SERVER_HOST=0.0.0.0
SPEECHLAB_SERVER_PORT=8443
SPEECHLAB_SSL_CERT=
SPEECHLAB_SSL_KEY=
# SPEECHLAB_UPLOAD_DIR=server/uploads
# SPEECHLAB_PROJECTS_ROOT=data/projects
# SPEECHLAB_JOBS_DIR=server/data/jobs
# SPEECHLAB_LOGS_DIR=server/data/logs
# SPEECHLAB_MAX_UPLOAD_MB=500
# SPEECHLAB_GUNICORN_BIND=127.0.0.1:8080

# SPEECHLAB_VOICE_CACHE=.speechlab_voice_bank

# Пайплайн (см. PRD.md)

# SPEECHLAB_MIN_PRIMARY_SEC=40

# SPEECHLAB_MAX_PRIMARY_SEC=90

# SPEECHLAB_ORIGINAL_AUDIO_RATIO=0.3

# SPEECHLAB_DUB_VOLUME_PERCENT=100

# SPEECHLAB_MAX_STRETCH=0.10

